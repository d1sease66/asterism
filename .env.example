# Telegram (stage 4). Leave empty to only log alerts.
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids ("chatId" or "chatId:threadId"); /start also subscribes.
TELEGRAM_CHAT_IDS=
REPORT_UTC_OFFSET_HOURS=3

# GMGN. Read from ~/.config/gmgn/.env when empty. Never commit a real key.
GMGN_API_KEY=
# Own limiter in front of GMGN (weight units per second / burst).
GMGN_RATE_PER_SEC=1
GMGN_BURST=8

# Collector. smartmoney adapts between MIN and MAX to the feed's turnover.
POLL_SMARTMONEY_SEC=20
POLL_SMARTMONEY_MIN_SEC=8
POLL_SMARTMONEY_MAX_SEC=30
POLL_KOL_SEC=60
POLL_KOL_MIN_SEC=20

# Signals and filters
CLUSTER_MIN_WALLETS=3
CLUSTER_WINDOW_MIN=30
MIN_BUY_USD=300
MC_MIN=30000
MC_MAX=20000000
LIQ_MIN=15000
MAX_RUG=0.3
MAX_BUNDLER=0.3
SIGNAL_COOLDOWN_MIN=60

# Public dashboard (Quorum) delay
PUBLIC_DELAY_MIN=15

PORT=5190
DATA_DIR=./data
